  "claims": [
    {
      "id": "T66-PRIORITY-S03-L-PECT-action",
      "field": "action",
      "appliesTo": "action_explanation",
      "contextId": null,
      "value": "팔을 살짝 벌린 준비 자세에서 몸통 쪽으로 모으는 대흉근의 대표 작용을 봅니다. 쇄골부·흉늑부·배부분의 몸통 쪽 연결은 유지되고 위팔뼈 쪽을 따라 표면이 변형됩니다. 선택한 부분과 주변 구조를 함께 표시합니다."
    },
    {
      "id": "T66-PRIORITY-S03-L-PECT-model_posture",
      "field": "model_posture",
      "appliesTo": "posture_condition",
      "contextId": null,
      "value": "교육용으로 작성한 짧은 대표 움직임입니다. 준비 구간과 선택 근육의 작용 구간을 구분하며 정상 가동범위나 힘을 계산하지 않습니다."
    },
    {
      "id": "T66-PRIORITY-S03-L-PECT-model_context",
      "field": "model_context",
      "appliesTo": "context_role",
      "contextId": "T66-PRIORITY-S03-L-PECT-CONTEXT",
      "value": "주변 근육과 뼈는 온전한 표면을 유지하며 함께 움직이거나 수동으로 변형됩니다. 개별 근육의 힘·활성도를 뜻하지 않습니다."
    }
  ],
