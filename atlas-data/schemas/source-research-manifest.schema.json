{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://human-atlas.local/schemas/source-research-manifest.schema.json",
  "title": "HUMAN ATLAS local source research manifest",
  "description": "Input contract for local provenance capture and field comparison. It does not grant human anatomy review or populate the production AI evidence overlay.",
  "type": "object",
  "required": [
    "schemaVersion",
    "manifestId",
    "fixtureOnly",
    "subjects",
    "sources",
    "accesses",
    "extractions",
    "comparisons"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "manifestId": { "$ref": "#/$defs/Id" },
    "fixtureOnly": { "type": "boolean" },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/Subject" },
      "uniqueItems": true
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/Source" },
      "uniqueItems": true
    },
    "accesses": {
      "type": "array",
      "items": { "$ref": "#/$defs/Access" },
      "uniqueItems": true
    },
    "extractions": {
      "type": "array",
      "items": { "$ref": "#/$defs/Extraction" },
      "uniqueItems": true
    },
    "comparisons": {
      "type": "array",
      "items": { "$ref": "#/$defs/Comparison" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "Id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "NonEmptyString": { "type": "string", "minLength": 1 },
    "Sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "Subject": {
      "type": "object",
      "required": ["id", "kind", "recordType", "fields"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "kind": { "const": "individual_muscle" },
        "recordType": { "enum": ["canonical", "synthetic_fixture"] },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/NonEmptyString" },
          "uniqueItems": true
        }
      }
    },
    "Source": {
      "type": "object",
      "required": ["id", "underlyingWorkId", "workIdentityBasis", "title", "url", "editionStatus", "edition"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "underlyingWorkId": { "type": ["string", "null"] },
        "workIdentityBasis": { "$ref": "#/$defs/NonEmptyString" },
        "title": { "$ref": "#/$defs/NonEmptyString" },
        "url": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(https?://|local://)"
        },
        "editionStatus": { "enum": ["verified", "not_exposed", "unknown"] },
        "edition": { "type": ["string", "null"] }
      }
    },
    "Access": {
      "type": "object",
      "required": [
        "id", "sourceId", "subjectId", "field", "locator", "accessedOn",
        "accessMethod", "textAccess", "accessOutcome", "note"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "sourceId": { "$ref": "#/$defs/Id" },
        "subjectId": { "$ref": "#/$defs/Id" },
        "field": { "$ref": "#/$defs/NonEmptyString" },
        "locator": { "$ref": "#/$defs/NonEmptyString" },
        "accessedOn": { "type": "string", "format": "date" },
        "accessMethod": {
          "enum": [
            "publisher_full_text", "repository_full_text", "secondary_full_text",
            "abstract", "metadata", "search_index", "legacy_record", "synthetic_fixture"
          ]
        },
        "textAccess": {
          "enum": [
            "full_text_opened", "partial_text_opened", "abstract_only", "metadata_only",
            "index_only", "legacy_record", "fixture_only", "unavailable"
          ]
        },
        "accessOutcome": { "enum": ["opened", "failed"] },
        "note": { "$ref": "#/$defs/NonEmptyString" },
        "failureReason": { "$ref": "#/$defs/NonEmptyString" }
      }
    },
    "Reference": {
      "type": "object",
      "required": ["sourceId", "accessId", "locator"],
      "additionalProperties": false,
      "properties": {
        "sourceId": { "$ref": "#/$defs/Id" },
        "accessId": { "$ref": "#/$defs/Id" },
        "locator": { "$ref": "#/$defs/NonEmptyString" }
      }
    },
    "Extraction": {
      "type": "object",
      "required": ["id", "subjectId", "field", "accessId", "value", "valueHash", "reference", "note"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "subjectId": { "$ref": "#/$defs/Id" },
        "field": { "$ref": "#/$defs/NonEmptyString" },
        "accessId": { "$ref": "#/$defs/Id" },
        "value": {},
        "valueHash": { "$ref": "#/$defs/Sha256" },
        "reference": { "$ref": "#/$defs/Reference" },
        "note": { "$ref": "#/$defs/NonEmptyString" }
      }
    },
    "Comparison": {
      "type": "object",
      "required": [
        "id", "subjectId", "field", "leftExtractionId", "rightExtractionId",
        "classification", "assessmentMode", "rationale"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "subjectId": { "$ref": "#/$defs/Id" },
        "field": { "$ref": "#/$defs/NonEmptyString" },
        "leftExtractionId": { "$ref": "#/$defs/Id" },
        "rightExtractionId": { "$ref": "#/$defs/Id" },
        "classification": {
          "enum": ["agreement", "wording_difference", "variation", "substantive_conflict", "not_comparable"]
        },
        "assessmentMode": { "enum": ["ai_candidate", "researcher_entered"] },
        "rationale": { "$ref": "#/$defs/NonEmptyString" }
      }
    }
  }
}
