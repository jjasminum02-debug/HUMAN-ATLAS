{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://human-atlas.invalid/schema/navigation.schema.json",
  "title": "HUMAN ATLAS product navigation and typed scene contract",
  "description": "Product navigation overlay. It preserves the source-region taxonomy and does not assert human review, attachment surfaces, or motion assets.",
  "type": "object",
  "required": [
    "schemaVersion",
    "status",
    "sourceClassification",
    "categories",
    "memberships",
    "structureInstances",
    "structureMeshMappings",
    "unmappedMeshContexts",
    "sceneManifests",
    "migrationNotes"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "T15b-navigation-v1" },
    "status": { "enum": ["partial_pilot_contract", "contract_only"] },
    "sourceClassification": { "$ref": "#/$defs/SourceClassification" },
    "categories": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/NavigationCategory" }
    },
    "memberships": { "type": "array", "items": { "$ref": "#/$defs/RegionMembership" } },
    "structureInstances": { "type": "array", "items": { "$ref": "#/$defs/StructureInstance" } },
    "structureMeshMappings": { "type": "array", "items": { "$ref": "#/$defs/StructureMeshMapping" } },
    "unmappedMeshContexts": { "type": "array", "items": { "$ref": "#/$defs/UnmappedMeshContext" } },
    "sceneManifests": { "type": "array", "items": { "$ref": "#/$defs/SceneManifest" } },
    "migrationNotes": { "$ref": "#/$defs/MigrationNotes" }
  },
  "$defs": {
    "Id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$" },
    "Sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "NonEmpty": { "type": "string", "minLength": 1 },
    "IdList": { "type": "array", "items": { "$ref": "#/$defs/Id" }, "uniqueItems": true },
    "SourceRef": {
      "type": "object",
      "required": ["path", "jsonPointer", "manifestSha256"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/NonEmpty" },
        "jsonPointer": { "$ref": "#/$defs/NonEmpty" },
        "manifestSha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "SourceClassification": {
      "type": "object",
      "required": ["path", "policy"],
      "additionalProperties": false,
      "properties": { "path": { "$ref": "#/$defs/NonEmpty" }, "policy": { "$ref": "#/$defs/NonEmpty" } }
    },
    "NavigationCategory": {
      "type": "object",
      "required": ["id", "order", "labelKo", "labelEn"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "order": { "type": "integer", "minimum": 1, "maximum": 12 },
        "labelKo": { "$ref": "#/$defs/NonEmpty" },
        "labelEn": { "$ref": "#/$defs/NonEmpty" }
      }
    },
    "RegionMembership": {
      "type": "object",
      "required": ["id", "categoryId", "entityKind", "entityId", "reason", "productDecisionRef", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "categoryId": { "$ref": "#/$defs/Id" },
        "entityKind": { "enum": ["muscle", "bone"] },
        "entityId": { "$ref": "#/$defs/Id" },
        "reason": { "$ref": "#/$defs/NonEmpty" },
        "productDecisionRef": { "$ref": "#/$defs/NonEmpty" },
        "status": { "enum": ["decision_only", "held"] }
      }
    },
    "StructureInstance": {
      "type": "object",
      "required": ["id", "structureId", "side", "variantId", "sourceRefs"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "structureId": { "$ref": "#/$defs/Id" },
        "side": { "enum": ["left", "right", "midline", "unpaired"] },
        "variantId": { "type": ["string", "null"] },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/SourceRef" } }
      }
    },
    "StructureMeshMapping": {
      "type": "object",
      "required": ["id", "structureInstanceId", "meshIds", "representationType", "evidenceIds", "sourceRefs", "sourceLinkageState", "reviewState", "humanReviewState", "geometryState", "attachmentLocationState", "motionState"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "structureInstanceId": { "$ref": "#/$defs/Id" },
        "meshIds": { "$ref": "#/$defs/IdList" },
        "representationType": { "enum": ["whole_bone_context_only"] },
        "evidenceIds": { "$ref": "#/$defs/IdList" },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/SourceRef" } },
        "sourceLinkageState": { "enum": ["inherited_t12_source_manifest", "inherited_t13_source_crosswalk"] },
        "reviewState": { "enum": ["needs_review", "held", "reviewed", "stale"] },
        "humanReviewState": { "enum": ["not_reviewed", "pending", "reviewed"] },
        "geometryState": { "const": "whole_structure_context_only" },
        "attachmentLocationState": { "const": "none" },
        "motionState": { "const": "absent" }
      }
    },
    "Selection": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "conceptId"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "muscle" },
            "conceptId": { "$ref": "#/$defs/Id" },
            "instanceId": { "$ref": "#/$defs/Id" },
            "partId": { "$ref": "#/$defs/Id" },
            "meshId": { "$ref": "#/$defs/Id" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "conceptId"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "bone" },
            "conceptId": { "$ref": "#/$defs/Id" },
            "instanceId": { "$ref": "#/$defs/Id" },
            "meshId": { "$ref": "#/$defs/Id" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "conceptId"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "landmark" },
            "conceptId": { "$ref": "#/$defs/Id" },
            "instanceId": { "$ref": "#/$defs/Id" },
            "meshId": { "$ref": "#/$defs/Id" }
          }
        }
      ]
    },
    "StateDimensions": {
      "type": "object",
      "required": ["sourceRelation", "humanAnatomyReview", "staticGeometry", "attachmentLocation", "motion"],
      "additionalProperties": false,
      "properties": {
        "sourceRelation": { "$ref": "#/$defs/NonEmpty" },
        "humanAnatomyReview": { "enum": ["not_reviewed", "pending", "reviewed"] },
        "staticGeometry": { "$ref": "#/$defs/NonEmpty" },
        "attachmentLocation": { "enum": ["none", "text_only", "candidate", "reviewed_surface"] },
        "motion": { "enum": ["absent", "text_ready", "clip_draft", "educational_ready"] }
      }
    },
    "SceneAssetRef": {
      "type": "object",
      "required": ["modelId", "uri", "sha256", "meshAssetIds"],
      "additionalProperties": false,
      "properties": {
        "modelId": { "$ref": "#/$defs/Id" },
        "uri": { "$ref": "#/$defs/NonEmpty" },
        "sha256": { "$ref": "#/$defs/Sha256" },
        "meshAssetIds": { "$ref": "#/$defs/IdList" }
      }
    },
    "SelectableBinding": {
      "type": "object",
      "required": ["meshAssetId", "sourceMappingId", "reviewState", "selection", "stateDimensions"],
      "additionalProperties": false,
      "properties": {
        "meshAssetId": { "$ref": "#/$defs/Id" },
        "sourceMappingId": { "$ref": "#/$defs/Id" },
        "reviewState": { "enum": ["needs_review", "held", "reviewed", "stale"] },
        "selection": { "$ref": "#/$defs/Selection" },
        "stateDimensions": { "$ref": "#/$defs/StateDimensions" }
      }
    },
    "ContextBinding": {
      "type": "object",
      "required": ["meshAssetId", "modelId", "selection", "reasonCode", "stateDimensions"],
      "additionalProperties": false,
      "properties": {
        "meshAssetId": { "$ref": "#/$defs/Id" },
        "modelId": { "$ref": "#/$defs/Id" },
        "selection": { "type": "null" },
        "reasonCode": { "enum": ["canonical_target_unconfirmed", "target_is_not_canonical_bone"] },
        "stateDimensions": { "$ref": "#/$defs/StateDimensions" }
      }
    },
    "SceneManifest": {
      "type": "object",
      "required": ["id", "categoryId", "revision", "availability", "assetRefs", "selectableBindings", "contextBindings", "defaultView", "frameId", "units", "poseId", "modelId", "stateDimensions"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "categoryId": { "$ref": "#/$defs/Id" },
        "revision": { "$ref": "#/$defs/Id" },
        "availability": { "enum": ["available", "partial", "unavailable"] },
        "assetRefs": { "type": "array", "items": { "$ref": "#/$defs/SceneAssetRef" } },
        "selectableBindings": { "type": "array", "items": { "$ref": "#/$defs/SelectableBinding" } },
        "contextBindings": { "type": "array", "items": { "$ref": "#/$defs/ContextBinding" } },
        "defaultView": {
          "type": "object",
          "required": ["side", "selection"],
          "additionalProperties": false,
          "properties": { "side": { "enum": ["left", "right", "midline", "unpaired"] }, "selection": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/Selection" }] } }
        },
        "frameId": { "$ref": "#/$defs/Id" },
        "units": { "enum": ["m", "mm", "cm"] },
        "poseId": { "$ref": "#/$defs/Id" },
        "modelId": { "$ref": "#/$defs/Id" },
        "stateDimensions": { "$ref": "#/$defs/StateDimensions" }
      }
    },
    "UnmappedMeshContext": {
      "type": "object",
      "required": ["meshAssetId", "modelId", "sourceName", "sourceRefs", "evidenceIds", "selection", "reasonCode", "humanReviewState", "geometryState", "motionState"],
      "additionalProperties": false,
      "properties": {
        "meshAssetId": { "$ref": "#/$defs/Id" },
        "modelId": { "$ref": "#/$defs/Id" },
        "sourceName": { "$ref": "#/$defs/NonEmpty" },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/SourceRef" } },
        "evidenceIds": { "$ref": "#/$defs/IdList" },
        "selection": { "type": "null" },
        "reasonCode": { "enum": ["canonical_target_unconfirmed", "target_is_not_canonical_bone"] },
        "humanReviewState": { "enum": ["not_reviewed", "pending", "reviewed"] },
        "geometryState": { "$ref": "#/$defs/NonEmpty" },
        "motionState": { "const": "absent" }
      }
    },
    "MigrationNotes": {
      "type": "object",
      "required": ["canonicalCatalogMutation", "legacyMuscleInstancesPreserved", "legacyMeshMappingsPreserved", "userSpatialDraftsReadOrChanged", "humanApprovalCreated", "anatomicalClaimsCreated", "sourceRegionsCopiedOrRenamed", "motionAssetsCreated", "unresolvedSourceMeshesRemainUnbound"],
      "additionalProperties": false,
      "properties": {
        "canonicalCatalogMutation": { "const": false },
        "legacyMuscleInstancesPreserved": { "const": true },
        "legacyMeshMappingsPreserved": { "const": true },
        "userSpatialDraftsReadOrChanged": { "const": false },
        "humanApprovalCreated": { "const": false },
        "anatomicalClaimsCreated": { "const": false },
        "sourceRegionsCopiedOrRenamed": { "const": false },
        "motionAssetsCreated": { "const": false },
        "unresolvedSourceMeshesRemainUnbound": { "const": true }
      }
    }
  }
}
