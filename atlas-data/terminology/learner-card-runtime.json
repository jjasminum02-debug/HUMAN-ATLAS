  "nerveLearning": {
    "Common fibular nerve": {
      "courseContext": "무릎 뒤쪽에서 가쪽으로 향해 종아리뼈 머리 주위를 돌아 앞·뒤 가지로 이어집니다. 분지 위치와 가지가 지나가는 경로에는 해부학적 변이가 보고되어 있습니다.",
      "compressionContext": "종아리뼈 머리 주변은 신경이 얕게 지나는 구간으로 설명되며, 주변 띠와 조직의 형태도 사람마다 다를 수 있습니다. 모형은 한 정적 주행만 보여 줍니다.",
      "functionContext": "발목·발가락을 위로 드는 움직임과 발을 바깥으로 돌리는 움직임은 서로 다른 가지와 연결될 수 있습니다. 이 화면은 개인의 증상을 분류하지 않습니다."
    },
    "Deep fibular nerve": {
      "courseContext": "종아리 앞쪽 구획을 내려가며 발목을 위로 들고 발가락을 펴는 기능에 관여하는 근육들과 연결됩니다. 현재 확인된 모형 관계는 앞정강근 하나이며 전체 지배 범위는 아닙니다.",
      "compressionContext": "종아리 앞쪽의 근막·널힘줄 띠와 발목 앞 지지띠 부근을 지나는 해부 관계가 보고되어 있습니다. 현재 모형에는 이 띠나 압박 지점이 표시되어 있지 않습니다.",
      "functionContext": "발목 들기와 발가락 펴기 기능의 변화는 일반적인 해부학 학습 맥락입니다. 이 자료만으로 원인이나 병변 위치를 판단할 수 없습니다."
    },
    "Superficial fibular nerve": {
      "courseContext": "종아리 가쪽 구획으로 들어가며 발을 바깥으로 돌리는 근육과 발등 피부 감각의 일반적 경로에 연결됩니다. 현재 앱에는 확인된 가쪽구획 근육 관계가 등록되어 있지 않습니다.",
      "compressionContext": "가쪽 구획의 근막 통로와 분지 경로에 변이가 보고되어 있습니다. 현재 모형에는 개인별 가지나 별도 포착 구조가 표시되어 있지 않습니다.",
      "functionContext": "발 바깥돌림 기능과 발등 감각 영역은 서로 다른 정보이며, 이 학습 화면은 개인의 감각·운동 증상을 진단하지 않습니다."
    }
  },
