{
  "name": "human-atlas-local-explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "python3 scripts/validate-learning-content.py && python3 ../atlas-data/schemas/validate_ai_evidence.py --check && python3 ../atlas-data/schemas/validate_bone_name_overlay.py --check && python3 ../atlas-data/schemas/validate_motion_learning.py --check && python3 ../atlas-data/schemas/validate_motion_asset_sources.py && node scripts/check-scene-decoders.mjs && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "test:annotations": "node --experimental-strip-types --test src/viewer/annotationDrafts.test.ts && python3 scripts/validate-annotation-exchange-schema.py",
    "test:spatial-drafts": "node --experimental-strip-types --test src/viewer/spatialDraftLayer.test.ts && python3 scripts/validate-spatial-draft-schema.py",
    "test:search": "node --experimental-strip-types --test src/domain/search.test.ts src/data/boneNames.test.ts",
    "validate:bone-names": "python3 ../atlas-data/schemas/validate_bone_name_overlay.py --check",
    "test:navigation": "node --experimental-strip-types --test src/domain/navigation.test.ts && python3 ../atlas-data/navigation/test_navigation.py",
    "test:scene-lifecycle": "node --experimental-strip-types --test src/viewer/sceneCache.test.ts src/viewer/scenePlan.test.ts",
    "test:attachment-crosschecks": "node --experimental-strip-types --test src/domain/attachmentCrosschecks.test.ts",
    "test:ai-evidence": "node --experimental-strip-types --test src/domain/aiEvidence.test.ts src/domain/legacyEvidenceAdapter.test.ts src/domain/t18Evidence.integration.test.ts && python3 ../atlas-data/schemas/validate_ai_evidence.py --fixtures && python3 ../atlas-data/schemas/build_ai_evidence_overlay.py --check",
    "test:motion-learning": "node --experimental-strip-types --test src/domain/motionLearning.test.ts src/domain/legacyJointActionAdapter.test.ts && python3 ../atlas-data/schemas/validate_motion_learning.py --fixtures",
    "test:motion-player": "node --experimental-strip-types --test src/domain/motionPlayer.test.ts src/viewer/animationPlayback.test.ts src/data/learning.test.ts",
    "test:animation-loader": "node --experimental-strip-types --test src/viewer/animationSceneAdapter.test.ts && python3 ../atlas-data/schemas/test_motion_asset_representation_t22.py && python3 ../atlas-data/schemas/validate_motion_asset_sources.py",
    "qa:scene-decoders": "node scripts/check-scene-decoders.mjs",
    "migrate:navigation:dry-run": "python3 ../atlas-data/navigation/build_navigation.py --dry-run",
    "check:navigation-migration": "python3 ../atlas-data/navigation/build_navigation.py --check",
    "validate:navigation": "python3 ../atlas-data/navigation/validate_navigation.py",
    "validate:learning": "python3 scripts/validate-learning-content.py",
    "validate:ai-evidence": "python3 ../atlas-data/schemas/validate_ai_evidence.py --check",
    "validate:motion-learning": "python3 ../atlas-data/schemas/validate_motion_learning.py --check",
    "validate:spatial-drafts": "python3 scripts/validate-spatial-draft-schema.py",
    "prepare:whole-body": "python3 scripts/build-whole-body-t77.py && python3 scripts/check-whole-body-t77.py",
    "test:whole-body": "node --experimental-strip-types --test src/viewer/wholeBody/wholeBody.test.ts src/viewer/wholeBody/productContext.test.ts src/viewer/wholeBody/taskExtension.test.ts src/viewer/wholeBody/t101SceneExtension.test.ts src/viewer/wholeBody/t102SceneExtension.test.ts src/viewer/wholeBody/t103SceneExtension.test.ts src/viewer/wholeBody/t104SceneExtension.test.ts && python3 ../atlas-data/tools/test_extract_bodyparts3d_r4_selected_zip_members.py && python3 scripts/check-whole-body-t77.py && python3 ../atlas-data/tools/build_bodyparts3d_r4_t79.py --check && python3 ../atlas-data/tools/build_bodyparts3d_r4_t101.py --check && python3 ../atlas-data/tools/build_bodyparts3d_r4_t102.py --check && python3 ../atlas-data/tools/build_bodyparts3d_r4_t103.py --check && python3 ../atlas-data/tools/build_bodyparts3d_r4_t104.py --check && python3 ../work/evidence/T95/validate-overlay.py"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.12",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.186.0",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  }
}
