{
  "name": "human-atlas-local-explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\" \"scripts/*.test.ts\" \"scripts/*.test.mjs\" \"plugins/*.test.ts\"",
    "check": "pnpm check:data && pnpm build && pnpm check:dist",
    "check:data": "node --experimental-strip-types scripts/buildLearnerCardRuntime.mjs --check && node --experimental-strip-types scripts/buildLearnerMotionRuntime.mjs --check && python3 scripts/validate-learning-content.py && python3 ../atlas-data/schemas/validate_ai_evidence.py --check && python3 ../atlas-data/schemas/validate_bone_name_overlay.py --check && python3 ../atlas-data/schemas/validate_motion_learning.py --check && python3 ../atlas-data/schemas/validate_motion_asset_sources.py && python3 ../atlas-data/schemas/validate_t83_function_content.py --validate-only",
    "check:dist": "node scripts/auditLearnerCardDistribution.mjs --check && node scripts/checkLazyFeatures.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "qa:flows": "node scripts/qaFlows.mjs",
    "typecheck": "tsc -b --pretty false",
    "validate:bone-names": "python3 ../atlas-data/schemas/validate_bone_name_overlay.py --check",
    "test:ai-evidence": "node --experimental-strip-types --test src/domain/aiEvidence.test.ts src/domain/legacyEvidenceAdapter.test.ts src/domain/t18Evidence.integration.test.ts && python3 ../atlas-data/schemas/validate_ai_evidence.py --fixtures && python3 ../atlas-data/schemas/build_ai_evidence_overlay.py --check",
    "test:motion-learning": "node --experimental-strip-types --test src/domain/motionLearning.test.ts && python3 ../atlas-data/schemas/validate_motion_learning.py --fixtures",
    "test:motion-player": "node --experimental-strip-types --test src/domain/motionPlayer.test.ts src/viewer/animationPlayback.test.ts src/data/learning.test.ts src/domain/motionProjectionIndex.test.ts && node --experimental-strip-types --test scripts/serializeLearnerMotionRuntime.test.mjs && node --experimental-strip-types scripts/verifyOptimizedMotionRuntime.ts",
    "test:animation-loader": "node --experimental-strip-types --test src/viewer/animationSceneAdapter.test.ts && python3 ../atlas-data/schemas/test_motion_asset_representation_t22.py && python3 ../atlas-data/schemas/validate_motion_asset_sources.py",
    "migrate:navigation:dry-run": "python3 ../atlas-data/navigation/build_navigation.py --dry-run",
    "check:navigation-migration": "python3 ../atlas-data/navigation/build_navigation.py --check",
    "validate:navigation": "python3 ../atlas-data/navigation/validate_navigation.py",
    "validate:learning": "python3 scripts/validate-learning-content.py",
    "validate:t83-function": "python3 ../atlas-data/schemas/validate_t83_function_content.py --validate-only",
    "validate:ai-evidence": "python3 ../atlas-data/schemas/validate_ai_evidence.py --check",
    "validate:motion-learning": "python3 ../atlas-data/schemas/validate_motion_learning.py --check",
    "test:datasets": "node --experimental-strip-types --test src/viewer/datasets/*.test.ts",
    "test:lazy-loading": "node --experimental-strip-types --test src/domain/retryableResource.test.ts src/data/motionLearningData.test.ts"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.12",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.186.0",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  }
}
