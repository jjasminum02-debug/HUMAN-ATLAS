{
  "name": "human-atlas-local-explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "python3 scripts/validate-learning-content.py && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "test:annotations": "node --experimental-strip-types --test src/viewer/annotationDrafts.test.ts && python3 scripts/validate-annotation-exchange-schema.py",
    "test:spatial-drafts": "node --experimental-strip-types --test src/viewer/spatialDraftLayer.test.ts && python3 scripts/validate-spatial-draft-schema.py",
    "test:search": "node --experimental-strip-types --test src/domain/search.test.ts",
    "test:navigation": "node --experimental-strip-types --test src/domain/navigation.test.ts && python3 ../atlas-data/navigation/test_navigation.py",
    "migrate:navigation:dry-run": "python3 ../atlas-data/navigation/build_navigation.py --dry-run",
    "check:navigation-migration": "python3 ../atlas-data/navigation/build_navigation.py --check",
    "validate:navigation": "python3 ../atlas-data/navigation/validate_navigation.py",
    "validate:learning": "python3 scripts/validate-learning-content.py",
    "validate:spatial-drafts": "python3 scripts/validate-spatial-draft-schema.py"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.12",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.186.0",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  }
}
